# Netflix Panel
NETFLIX_PANEL_LOG_CHANNEL_ID=0          # ログ出力チャンネルID (0=無効)
NETFLIX_COOKIE_VALIDATION_URL=https://www.netflix.com/login  # クッキー検証用URL
NETFLIX_LOGIN_REDIRECT_URL=https://www.netflix.com/  # 生成するログインリンク

# AUTOCAT billing (Render requires Google Sheets credentials and a stable identity key)
AUTOCAT_BILLING_SHEET=autocat_billing
# Optional: Discord user ID whose existing PayPay account receives AUTOCAT payments (defaults to ADMIN_USER)
AUTOCAT_PAYPAY_ACCOUNT_ID=

# AUTOCAT: Discord VIP role (the bot must be a member of this server)
AUTOCAT_VIP_GUILD_ID=
AUTOCAT_VIP_ROLE_ID=
