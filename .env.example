# Netflix Panel
NETFLIX_PANEL_LOG_CHANNEL_ID=0          # ログ出力チャンネルID (0=無効)
NETFLIX_COOKIE_VALIDATION_URL=https://www.netflix.com/login
NETFLIX_LOGIN_REDIRECT_URL=https://www.netflix.com/

# AutoCat Discord vending — set the secret values in Render Environment Variables
AUTOCAT_ITEM_PRICE_YEN=50               # 1 selected item = 50 yen after the first 3 successful free orders
AUTOCAT_VIP_GUILD_ID=                   # Discord server ID where the manually assigned VIP role exists
AUTOCAT_VIP_ROLE_ID=                    # VIP role ID; the bot must be a member of the server
AUTOCAT_PANEL_CHANNEL_ID=               # Optional: Discord channel ID where the vending panel is auto-installed/reused on bot startup

# Required for durable billing snapshots on Render Free (no persistent disk)
SPREADSHEET_NAME=DiscordVendingDB
AUTOCAT_BILLING_SHEET=autocat_billing   # Creates/uses autocat_billing_meta, _a, and _b sheets
GOOGLE_CREDENTIALS_JSON=                # Full service-account JSON; share the spreadsheet with its client email
FLASK_SECRET_KEY=                       # Generate a long random value and keep it stable across deploys
IDENTITY_HASH_KEY=                      # Optional; use another stable random value, or leave empty to derive from FLASK_SECRET_KEY

# Optional PayPay recipient (defaults to ADMIN_USER's registered PayPay account)
AUTOCAT_PAYPAY_ACCOUNT_ID=
